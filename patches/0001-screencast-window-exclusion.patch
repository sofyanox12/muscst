 #include "core/boxes-private.h"
 #include "core/meta-debug-control-private.h"
+#include <glib.h>
+#include <glib/gstdio.h>
+
+/* Dynamic window actor buffer exclusion check for screencast */
+static GHashTable *exclude_set = NULL;
+static gint64 last_mtime = 0;
+static gboolean filter_enabled = TRUE;
+static char *config_path = NULL;
+
+static void
+reload_config_if_needed (void)
+{
+  GStatBuf st;
+
+  if (G_UNLIKELY (!config_path))
+    config_path = g_build_filename (g_get_user_config_dir (), "muscst", "state.json", NULL);
+
+  if (g_stat (config_path, &st) != 0)
+    return;
+
+  if (st.st_mtime != last_mtime)
+    {
+      gchar *contents = NULL;
+      last_mtime = st.st_mtime;
+
+      if (g_file_get_contents (config_path, &contents, NULL, NULL))
+        {
+          if (strstr (contents, "\"enabled\": false") || strstr (contents, "\"enabled\":false"))
+            filter_enabled = FALSE;
+          else if (strstr (contents, "\"enabled\": true") || strstr (contents, "\"enabled\":true"))
+            filter_enabled = TRUE;
+
+          if (!exclude_set)
+            exclude_set = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+          g_hash_table_remove_all (exclude_set);
+
+          char *p = strstr (contents, "\"exclude_classes\"");
+          if (p)
+            {
+              char *start_b = strchr (p, '[');
+              char *end_b = start_b ? strchr (start_b, ']') : NULL;
+              if (start_b && end_b)
+                {
+                  char *cur = start_b + 1;
+                  while (cur < end_b)
+                    {
+                      char *q1 = strchr (cur, '"');
+                      if (!q1 || q1 >= end_b)
+                        break;
+                      char *q2 = strchr (q1 + 1, '"');
+                      if (!q2 || q2 > end_b)
+                        break;
+                      if (q2 > q1 + 1)
+                        {
+                          char *item = g_strndup (q1 + 1, q2 - (q1 + 1));
+                          g_hash_table_insert (exclude_set, item, GINT_TO_POINTER (1));
+                        }
+                      cur = q2 + 1;
+                    }
+                }
+            }
+          g_free (contents);
+        }
+    }
+}
+
+gboolean
+meta_screen_cast_is_filter_enabled (void)
+{
+  reload_config_if_needed ();
+  return filter_enabled && exclude_set && g_hash_table_size (exclude_set) > 0;
+}
+
+gboolean
+meta_screen_cast_is_window_excluded (const char *wm_class,
+                                     const char *app_id,
+                                     const char *wm_instance)
+{
+  reload_config_if_needed ();
+  if (!filter_enabled || !exclude_set)
+    return FALSE;
+
+  return ((wm_class && g_hash_table_contains (exclude_set, wm_class)) ||
+          (app_id && g_hash_table_contains (exclude_set, app_id)) ||
+          (wm_instance && g_hash_table_contains (exclude_set, wm_instance)));
+}
 
