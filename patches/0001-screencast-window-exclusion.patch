+static gboolean
+meta_window_actor_is_excluded (MetaWindowActor *self)
+{
+  MetaWindowActorPrivate *priv = meta_window_actor_get_instance_private (self);
+  MetaWindow *window = priv->window;
+
+  while (window)
+    {
+      const char *wm_class = meta_window_get_wm_class (window);
+      const char *app_id = meta_window_get_gtk_application_id (window);
+      const char *wm_instance = meta_window_get_wm_class_instance (window);
+
+      if (meta_screen_cast_is_window_excluded (wm_class, app_id, wm_instance))
+        return TRUE;
+
+      window = meta_window_get_transient_for (window);
+    }
+
+  return FALSE;
+}
+
+static void
+meta_window_actor_paint (ClutterActor        *actor,
+                         ClutterPaintContext *paint_context)
+{
+  ClutterPaintFlag flags = clutter_paint_context_get_paint_flags (paint_context);
+
+  if (flags & CLUTTER_PAINT_FLAG_SCREENCAST)
+    {
+      if (meta_window_actor_is_excluded (META_WINDOW_ACTOR (actor)))
+        return;
+    }
+
+  CLUTTER_ACTOR_CLASS (meta_window_actor_parent_class)->paint (actor, paint_context);
+}
