+  if (!graphene_matrix_equal_fast (matrix, &overlay->default_transform))
+    {
+      cogl_pipeline_set_layer_matrix (overlay->default_pipeline, 0, matrix);
+      graphene_matrix_init_from_matrix (&overlay->default_transform, matrix);
+    }
+
+  overlay->default_current_rect = *dst_rect;
